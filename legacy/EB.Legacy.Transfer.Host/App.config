  <connectionStrings>
    <!-- Demo: gercek veritabani yoktur -->
    <add name="EftDb" connectionString="Server=EFTDB01;Database=EftIslem;User Id=eft_app;Password=Eft2019!;" providerName="System.Data.SqlClient" />
